<mxfile host="app.diagrams.net"><diagram name="Windows 11 STIG · how each failed setting was fixed and proven"><mxGraphModel dx="1200" dy="900" grid="0" background="#0f141c" page="1" pageWidth="1300" pageHeight="1184"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Windows 11 STIG · how each failed setting was fixed and proven" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#eef2f7;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="lg0" value="Tenable scan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="Choose" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="Fix" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="Decision / lesson" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="180" height="28" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;Start:&lt;/b&gt; run the DISA Windows 11 STIG audit&lt;br&gt;as a scan that logs in: &lt;b&gt;258 checks, 142 failed&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="380" height="74" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;Take the next failed finding.&lt;/b&gt;&lt;br&gt;Ten were chosen to fix." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#3a3018;strokeColor=#f2b134;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="244" width="380" height="74" as="geometry"/></mxCell><mxCell id="b" value="Write &lt;b&gt;one PowerShell script&lt;/b&gt; that sets exactly&lt;br&gt;that setting and prints the value back." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="358" width="380" height="74" as="geometry"/></mxCell><mxCell id="c" value="Run it as Administrator&lt;br&gt;on the Windows 11 VM." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#173326;strokeColor=#5fd38d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="472" width="380" height="74" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;Rescan&lt;/b&gt; with the same scan." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="586" width="380" height="74" as="geometry"/></mxCell><mxCell id="q1" value="Did the finding move&lt;br&gt;from Failed to Passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="700" width="300" height="120" as="geometry"/></mxCell><mxCell id="q2" value="Any of the ten&lt;br&gt;still to fix?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="860" width="300" height="120" as="geometry"/></mxCell><mxCell id="z" value="&lt;b&gt;End: 10 of 10 failed → passed.&lt;/b&gt;&lt;br&gt;Failed checks 142 → 131, passed 105 → 116." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#16283d;strokeColor=#5aa9ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="1020" width="380" height="74" as="geometry"/></mxCell><mxCell id="n1" value="&lt;i&gt;Lesson.&lt;/i&gt; The scanner can be stricter than&lt;br&gt;the checklist. The first security-log fix&lt;br&gt;(1,024,000 KB) failed; it needed 5,120,000." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="708.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="n2" value="&lt;i&gt;Lesson.&lt;/i&gt; The host-firewall finding kept&lt;br&gt;failing with Windows' own tools, so it was&lt;br&gt;swapped for another rather than forced." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="229.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="n0" value="The scan needs the firewall opened,&lt;br&gt;Remote Registry on and remote UAC&lt;br&gt;relaxed. All of it was put back afterwards." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#eef2f7;fillColor=#1b222c;strokeColor=#6b7a8c;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="115.0" width="320" height="104" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="d" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;" edge="1" parent="1" source="q2" target="z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="q1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="a" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;dashed=1;" edge="1" parent="1" source="s" target="n0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lp0" value="No · fix the script" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q1" target="b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="760.0"/><mxPoint x="410" y="395.0"/></Array></mxGeometry></mxCell><mxCell id="lp1" value="Yes · next finding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#c9d3df;fontColor=#eef2f7;fontSize=13;fontStyle=1;labelBackgroundColor=#0f141c;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q2" target="a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="920.0"/><mxPoint x="220" y="281.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>